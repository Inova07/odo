    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1"
  }
