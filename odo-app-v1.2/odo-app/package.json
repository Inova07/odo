{
  "name": "odo-app",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Odo — shift & expense tracker for Australian food-delivery drivers",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-pages.mjs",
